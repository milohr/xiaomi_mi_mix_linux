From: xiaomi-mi-linux-port contributors
Subject: [PATCH] lk2nd: msm8996: add Xiaomi Mi MIX

Add the original Xiaomi Mi MIX (lithium) to the MSM8996 device bundle.
The match values come from the two lithium DTBs in the exact V11.0.2.0.OAHMIXM
stock boot image: board ID 38, MSM8996 v3/Pro revisions, and PMI8996 IDs.

---
 lk2nd/device/dts/msm8996/msm8996pro-xiaomi-lithium.dts | 17 +++++++++++++++++
 lk2nd/device/dts/msm8996/rules.mk                       |  1 +
 2 files changed, 18 insertions(+)
 create mode 100644 lk2nd/device/dts/msm8996/msm8996pro-xiaomi-lithium.dts

diff --git a/lk2nd/device/dts/msm8996/msm8996pro-xiaomi-lithium.dts b/lk2nd/device/dts/msm8996/msm8996pro-xiaomi-lithium.dts
new file mode 100644
index 0000000..f36aaac
--- /dev/null
+++ b/lk2nd/device/dts/msm8996/msm8996pro-xiaomi-lithium.dts
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include <skeleton64.dtsi>
+#include <lk2nd.dtsi>
+
+/ {
+	qcom,msm-id =
+		<QCOM_ID_MSM8996 0x30000>,
+		<QCOM_ID_MSM8996SG 0x10000>;
+	qcom,board-id = <38 0>;
+	qcom,pmic-id = <0x20009 0x10013 0x00 0x00>;
+};
+
+&lk2nd {
+	model = "Xiaomi Mi MIX";
+	compatible = "xiaomi,lithium";
+};
diff --git a/lk2nd/device/dts/msm8996/rules.mk b/lk2nd/device/dts/msm8996/rules.mk
index e38b966..9e0d8e1 100644
--- a/lk2nd/device/dts/msm8996/rules.mk
+++ b/lk2nd/device/dts/msm8996/rules.mk
@@ -3,6 +3,7 @@ LOCAL_DIR := $(GET_LOCAL_DIR)
 
 ADTBS += \
 	$(LOCAL_DIR)/msm8996pro-oneplus3t.dtb \
+	$(LOCAL_DIR)/msm8996pro-xiaomi-lithium.dtb \
 	$(LOCAL_DIR)/msm8996pro-xiaomi-scorpio.dtb \
 	$(LOCAL_DIR)/msm8996-lg-h850.dtb \
 	$(LOCAL_DIR)/msm8996-lg-h990.dtb \
-- 
2.51.0
