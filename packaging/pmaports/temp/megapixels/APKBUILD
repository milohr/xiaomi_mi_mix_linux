65cb74ef9153a9968dc7e5c34ea587ffb5587b7405d87b8ad8ce9fd44e7f0f38b0421def5c6a01b0da7a7916fed61df8d07bb4e77cc013bea2acdf46b0ce9ae6  qr-tap-scale.patch
"
