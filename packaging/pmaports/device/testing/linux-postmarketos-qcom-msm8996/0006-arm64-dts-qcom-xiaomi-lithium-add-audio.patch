From: Xiaomi Mi MIX Linux port contributors
Subject: [PATCH] arm64: dts: qcom: xiaomi-lithium: add audio (codec)

Enable the ADSP with lithium's firmware and the WCD9335 codec on SLIMbus
for headphones and microphones (verified: headphone playback through the
ADSP, SLIMBUS_4_RX, AIF1_PB). Codec values are from the stock device tree;
the supply layout follows msm8996-xiaomi-common. The speaker amplifier
(stock says TFA9890, the chip reports a TFA9891) follows separately; the
LM48560 piezo earpiece amplifier has no mainline driver.

---
diff --git a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
--- a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
@@ -12,6 +12,9 @@
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+#include <dt-bindings/sound/qcom,wcd9335.h>
 #include "msm8996pro.dtsi"
 #include "pm8994.dtsi"
 #include "pmi8994.dtsi"
@@ -84,6 +87,31 @@
 		pinctrl-names = "default";
 	};
 
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3600000>;
+		regulator-max-microvolt = <3600000>;
+		regulator-always-on;
+	};
+
+	vph_pwr_bbyp: vph-pwr-bbyp-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr_bbyp";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+
+	divclk1_cdc: divclk1 {
+		compatible = "gpio-gate-clock";
+		clocks = <&rpmcc RPM_SMD_DIV_CLK1>;
+		#clock-cells = <0>;
+		enable-gpios = <&pm8994_gpios 15 GPIO_ACTIVE_HIGH>;
+		pinctrl-0 = <&divclk1_default>;
+		pinctrl-names = "default";
+	};
+
 	disp_vddr: disp-vddr-regulator {
 		compatible = "regulator-fixed";
 		regulator-name = "disp_vddr";
@@ -309,6 +337,14 @@
 	};
 
 	/* Stock gpio@c800: output high, VIN0 (VPH), low strength. */
+	divclk1_default: divclk1-state {
+		pins = "gpio15";
+		function = PMIC_GPIO_FUNC_FUNC1;
+		bias-disable;
+		power-source = <PM8994_GPIO_S4>;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
+	};
+
 	rome_enable_default: rome-enable-state {
 		pins = "gpio9";
 		function = PMIC_GPIO_FUNC_NORMAL;
@@ -537,3 +573,86 @@
 	phys = <&hsusb_phy1>;
 	phy-names = "usb2-phy";
 };
+
+
+/*
+ * WCD9335 audio path. The stock-only LM48560 piezo earpiece and the TFA9890
+ * speaker routing are intentionally left disabled until their DAI topology is
+ * verified; this exposes codec playback/capture first.
+ */
+&adsp_pil {
+	firmware-name = "qcom/msm8996/lithium/adsp.mbn";
+	status = "okay";
+};
+
+&slim_msm {
+	status = "okay";
+
+	slim@1 {
+		reg = <1>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		tasha_ifd: tas-ifd@0,0 {
+			compatible = "slim217,1a0";
+			reg = <0 0>;
+		};
+
+		wcd9335: codec@1,0 {
+			compatible = "slim217,1a0";
+			reg = <1 0>;
+			clock-names = "mclk", "slimbus";
+			clocks = <&divclk1_cdc>, <&rpmcc RPM_SMD_BB_CLK1>;
+			interrupt-parent = <&tlmm>;
+			interrupts = <54 IRQ_TYPE_LEVEL_HIGH>, <53 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "intr1", "intr2";
+			interrupt-controller;
+			#interrupt-cells = <1>;
+			pinctrl-0 = <&cdc_reset_active &wcd_intr_default>;
+			pinctrl-names = "default";
+			reset-gpios = <&tlmm 64 GPIO_ACTIVE_LOW>;
+			slim-ifc-dev = <&tasha_ifd>;
+			#sound-dai-cells = <1>;
+			vdd-buck-supply = <&vreg_s4a_1p8>;
+			vdd-buck-sido-supply = <&vreg_s4a_1p8>;
+			vdd-rx-supply = <&vreg_s4a_1p8>;
+			vdd-tx-supply = <&vreg_s4a_1p8>;
+			vdd-vbat-supply = <&vph_pwr>;
+			vdd-micbias-supply = <&vph_pwr_bbyp>;
+			vdd-io-supply = <&vreg_s4a_1p8>;
+		};
+	};
+};
+
+&q6asmdai {
+	dai@0 { reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>; };
+};
+
+&sound {
+	compatible = "qcom,apq8096-sndcard";
+	model = "lithium";
+	audio-routing = "RX_BIAS", "MCLK",
+			"AMIC1", "MIC BIAS4",
+			"AMIC2", "MIC BIAS2",
+			"AMIC3", "MIC BIAS4",
+			"AMIC4", "MIC BIAS1";
+
+	mm1-dai-link {
+		link-name = "MultiMedia1";
+		cpu { sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>; };
+	};
+
+	wcd-aif1-pb-dai-link {
+		link-name = "AIF1_PB";
+		cpu { sound-dai = <&q6afedai SLIMBUS_4_RX>; };
+		platform { sound-dai = <&q6routing>; };
+		codec { sound-dai = <&wcd9335 AIF1_PB>; };
+	};
+
+	wcd-aif1-cap-dai-link {
+		link-name = "AIF1_CAP";
+		cpu { sound-dai = <&q6afedai SLIMBUS_0_TX>; };
+		platform { sound-dai = <&q6routing>; };
+		codec { sound-dai = <&wcd9335 AIF1_CAP>; };
+	};
+};
