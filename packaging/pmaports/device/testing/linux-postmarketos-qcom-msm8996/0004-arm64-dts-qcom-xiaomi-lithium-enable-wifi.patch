From: Xiaomi Mi MIX Linux port contributors
Subject: [PATCH] arm64: dts: qcom: xiaomi-lithium: enable Wi-Fi

Enable PCIe0 for the QCA6174 Wi-Fi with the stock wiring: WL_EN on PM8994
GPIO 8, the 3.3 V rome supply on PM8994 GPIO 9, PERST on TLMM 35, WAKE on
TLMM 37, the PHY on L28/L12, and the chip's S3 core and L30 crystal rails.

---
diff --git a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
--- a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
@@ -40,6 +40,37 @@
 	 * the bootloader. Nothing in mainline consumes it yet (stock hangs it on
 	 * the DSI controller as vddr-supply), so keep it always on.
 	 */
+	/*
+	 * QCA6174 Wi-Fi power, from stock rome_vreg (PM8994 GPIO 9, 4 ms) and
+	 * wlan_en_vreg (PM8994 GPIO 8); the 70 ms WL_EN settle time is the
+	 * Xiaomi siblings' (msm8996-xiaomi-common.dtsi), stock sets none.
+	 */
+	vdd_3v3_rome: rome-vreg {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_3v3_rome";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&pm8994_gpios 9 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <4000>;
+		pinctrl-0 = <&rome_enable_default>;
+		pinctrl-names = "default";
+		/* QCA6174 vddpe-3v3 */
+		regulator-always-on;
+	};
+
+	wlan_en: wlan-en-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan_en";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&pm8994_gpios 8 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <70000>;
+		pinctrl-0 = <&wlan_en_default>;
+		pinctrl-names = "default";
+	};
+
 	disp_vddr: disp-vddr-regulator {
 		compatible = "regulator-fixed";
 		regulator-name = "disp_vddr";
@@ -243,6 +274,44 @@
 		bias-pull-up;
 		power-source = <PM8994_GPIO_S4>;
 	};
+
+	/* Stock gpio@c700: output low, VIN2 (S4 1.8 V), no pull. */
+	wlan_en_default: wlan-en-state {
+		pins = "gpio8";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		output-low;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
+		power-source = <PM8994_GPIO_S4>;
+		bias-disable;
+	};
+
+	/* Stock gpio@c800: output high, VIN0 (VPH), low strength. */
+	rome_enable_default: rome-enable-state {
+		pins = "gpio9";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		output-high;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
+		power-source = <PM8994_GPIO_VPH>;
+	};
+};
+
+&pcie0 {
+	/* QCA6174 on root complex 0 (stock qcom,cnss wlan-rc-num 0). */
+	vddpe-3v3-supply = <&wlan_en>;
+	vdda-supply = <&vreg_l28a_0p925>;
+
+	perst-gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
+
+	status = "okay";
+};
+
+&pcie_phy {
+	/* Stock PCIe vreg-0.9 = L28, vreg-1.8 = L12. */
+	vdda-phy-supply = <&vreg_l28a_0p925>;
+	vdda-pll-supply = <&vreg_l12a_1p8>;
+
+	status = "okay";
 };
 
 &pm8994_resin {
@@ -266,6 +335,14 @@
 		compatible = "qcom,rpm-pm8994-regulators";
 
 		/* Shared 1.8 V I/O rail; kept on, as on other MSM8996 boards. */
+		/* QCA6174 vdd-core (stock pm8994_s3, 1.3 V). */
+		vreg_s3a_1p3: s3 {
+			regulator-name = "vreg_s3a_1p3";
+			regulator-min-microvolt = <1300000>;
+			regulator-max-microvolt = <1300000>;
+			regulator-always-on;
+		};
+
 		vreg_s4a_1p8: s4 {
 			regulator-name = "vreg_s4a_1p8";
 			regulator-min-microvolt = <1800000>;
@@ -322,6 +399,14 @@
 			regulator-min-microvolt = <925000>;
 			regulator-max-microvolt = <925000>;
 		};
+
+		/* QCA6174 vddio-xtal (stock pm8994_l30, 1.8 V). */
+		vreg_l30a_1p8: l30 {
+			regulator-name = "vreg_l30a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
+		};
 	};
 };
 
