From: Xiaomi Mi MIX Linux port contributors
Subject: [PATCH] arm64: dts: qcom: xiaomi-lithium: add the PMI8994 ADC

Describe PMI8994's voltage ADC (stock vadc@3100) with the USB and DC
input channels behind their 1/20 divider, and give the charger the USB
input channel, so the input voltage can be read (and checked before
any higher-voltage charging).

---
--- a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
@@ -9,6 +9,7 @@
 #include <dt-bindings/clock/qcom,mmcc-msm8996.h>
 #include <dt-bindings/clock/qcom,rpmcc.h>
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/iio/qcom,spmi-vadc.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
@@ -1200,3 +1201,50 @@
 		label = "white:torch";
 	};
 };
+
+/* ADC of PMI8994 (SID 2, stock vadc@3100): USB/DC input voltage behind a 1/20 divider */
+&{/soc@0/spmi@400f000/pmic@2} {
+	pmi8994_adc: adc@3100 {
+		compatible = "qcom,spmi-vadc";
+		reg = <0x3100>;
+		interrupts = <0x2 0x31 0x0 IRQ_TYPE_EDGE_RISING>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		#io-channel-cells = <1>;
+
+		channel@0 {
+			reg = <VADC_USBIN>;
+			qcom,pre-scaling = <1 20>;
+			label = "usbin";
+		};
+
+		channel@1 {
+			reg = <VADC_DCIN>;
+			qcom,pre-scaling = <1 20>;
+			label = "dcin";
+		};
+
+		channel@9 {
+			reg = <VADC_REF_625MV>;
+			label = "ref_625mv";
+		};
+
+		channel@a {
+			reg = <VADC_REF_1250MV>;
+			label = "ref_1250mv";
+		};
+
+		channel@e {
+			reg = <VADC_GND_REF>;
+		};
+
+		channel@f {
+			reg = <VADC_VDD_VADC>;
+		};
+	};
+};
+
+&pmi8994_smbchg {
+	io-channels = <&pmi8994_adc VADC_USBIN>;
+	io-channel-names = "usbin";
+};
