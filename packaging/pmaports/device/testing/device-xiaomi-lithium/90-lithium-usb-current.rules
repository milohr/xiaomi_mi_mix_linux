# Type-C current advertisement -> charger input limit: see /usr/libexec/lithium-usb-current.
ACTION=="change", SUBSYSTEM=="typec", KERNEL=="port0", RUN+="/usr/libexec/lithium-usb-current"
ACTION=="change", SUBSYSTEM=="power_supply", KERNEL=="qcom-smbchg-usb", RUN+="/usr/libexec/lithium-usb-current"
