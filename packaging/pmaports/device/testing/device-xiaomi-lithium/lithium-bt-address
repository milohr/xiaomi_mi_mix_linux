#!/bin/sh
# Xiaomi Mi MIX (lithium): give the QCA6174 Bluetooth controller its own
# public address. The controller has none of its own, so the kernel keeps it
# unconfigured until one is set. Stock keeps it in persist:/wlan_bt/bt.mac,
# six bytes in reversed (little-endian) order. persist is mounted read-only.
set -eu

DEV=/dev/disk/by-partlabel/persist
[ -b "$DEV" ] || exit 0

dir=$(mktemp -d)
trap 'umount "$dir" 2>/dev/null; rmdir "$dir"' EXIT
mount -o ro,noload "$DEV" "$dir" 2>/dev/null || mount -o ro "$DEV" "$dir"
[ -r "$dir/wlan_bt/bt.mac" ] || exit 0

addr=$(od -An -tx1 -v "$dir/wlan_bt/bt.mac" |
	awk '{ for (i = NF; i >= 1; i--) printf "%s%s", toupper($i), (i > 1 ? ":" : "") }')
case "$addr" in
??:??:??:??:??:??) ;;
*) logger -t lithium-bt-address "unexpected bt.mac contents"; exit 1 ;;
esac

# A soft-blocked controller is not registered with the management interface,
# so the address cannot be set: unblock it for the moment and restore the
# user's choice afterwards. systemd-rfkill may restore a saved block while
# this runs, so check again before every attempt; at boot the controller can
# also still be settling, so retry for a few seconds.
rfk=
for r in /sys/class/rfkill/rfkill*; do
	if [ "$(cat "$r/type" 2>/dev/null)" = bluetooth ]; then
		rfk=$r
		break
	fi
done

blocked=0
ret=1
out=
i=0
while [ "$i" -lt 10 ]; do
	if [ -n "$rfk" ] && [ "$(cat "$rfk/soft")" = 1 ]; then
		blocked=1
		echo 0 > "$rfk/soft"
		sleep 1
	fi
	if out=$(btmgmt --index 0 public-addr "$addr" 2>&1); then
		ret=0
		break
	fi
	i=$((i + 1))
	sleep 1
done

if [ "$blocked" = 1 ]; then
	echo 1 > "$rfk/soft"
fi
if [ "$ret" != 0 ]; then
	logger -t lithium-bt-address "setting the address failed: $out"
	exit 1
fi
logger -t lithium-bt-address "Bluetooth public address set from persist"
