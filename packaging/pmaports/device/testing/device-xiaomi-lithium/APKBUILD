# Reference: <https://postmarketos.org/devicepkg>
maintainer="Camilo Higuita <milo.h@aol.com>"
pkgname=device-xiaomi-lithium
pkgdesc="Xiaomi Mi MIX"
pkgver=1
pkgrel=8
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-msm8996
	mkbootimg
	postmarketos-base
	linux-firmware-ath10k
	soc-qcom-msm8996
	"
makedepends="devicepkg-dev"
source="
	deviceinfo
	sxmo-deviceprofile.sh
	ucm-lithium.conf
	ucm-HiFi.conf
	wireplumber-51-lithium-audio.conf
	lithium-usb-current
	lithium-usb-current.service
	90-lithium-usb-current.rules
	environment-webengine.conf
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir"/sxmo-deviceprofile.sh \
		"$pkgdir"/usr/bin/sxmo_deviceprofile_xiaomi,lithium.sh
	install -Dm644 "$srcdir"/ucm-lithium.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/apq8096/lithium.conf
	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Xiaomi/lithium/HiFi.conf
	install -Dm644 "$srcdir"/wireplumber-51-lithium-audio.conf \
		"$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/51-lithium-audio.conf
	install -Dm755 "$srcdir"/lithium-usb-current \
		"$pkgdir"/usr/libexec/lithium-usb-current
	install -Dm644 "$srcdir"/lithium-usb-current.service \
		"$pkgdir"/usr/lib/systemd/system/lithium-usb-current.service
	install -Dm644 "$srcdir"/90-lithium-usb-current.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-lithium-usb-current.rules
	install -Dm644 "$srcdir"/environment-webengine.conf \
		"$pkgdir"/usr/lib/environment.d/50-lithium-webengine.conf
}

