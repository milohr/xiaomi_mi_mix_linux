# Reference: <https://postmarketos.org/devicepkg>
maintainer="Camilo Higuita <milo.h@aol.com>"
pkgname=device-xiaomi-lithium
pkgdesc="Xiaomi Mi MIX"
pkgver=1
pkgrel=22
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-msm8996
	mkbootimg
	postmarketos-base
	bluez-btmgmt
	linux-firmware-ath10k
	soc-qcom-msm8996
	rmtfs
	tqftpserv
	qmi-utils
	"
makedepends="devicepkg-dev"
source="
	deviceinfo
	ucm-lithium.conf
	ucm-HiFi.conf
	wireplumber-51-lithium-audio.conf
	lithium-usb-current
	90-lithium-usb-current.rules
	lithium-bt-address
	lithium-bt-address.service
	90-lithium-mesa.conf
	91-lithium-bt-address.rules
	92-lithium-sensors.rules
	mpv.conf
	libcamera-ov16880.yaml
	libcamera-ov5675.yaml
	rmtfs-lithium.conf
	lithium-rmtfs-setup.service
	lithium-rmtfs-setup
	lithium-modem
	lithium-modem.service
	modprobe-lithium-ipa.conf
	90-lithium.preset
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/ucm-lithium.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/apq8096/lithium.conf
	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Xiaomi/lithium/HiFi.conf
	install -Dm644 "$srcdir"/wireplumber-51-lithium-audio.conf \
		"$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/51-lithium-audio.conf
	install -Dm755 "$srcdir"/lithium-usb-current \
		"$pkgdir"/usr/libexec/lithium-usb-current
	install -Dm644 "$srcdir"/90-lithium-usb-current.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-lithium-usb-current.rules
	install -Dm755 "$srcdir"/lithium-bt-address \
		"$pkgdir"/usr/libexec/lithium-bt-address
	install -Dm644 "$srcdir"/lithium-bt-address.service \
		"$pkgdir"/usr/lib/systemd/system/lithium-bt-address.service
	install -Dm644 "$srcdir"/90-lithium-mesa.conf \
		"$pkgdir"/usr/lib/environment.d/90-lithium-mesa.conf
	install -Dm644 "$srcdir"/91-lithium-bt-address.rules \
		"$pkgdir"/usr/lib/udev/rules.d/91-lithium-bt-address.rules
	install -Dm644 "$srcdir"/92-lithium-sensors.rules \
		"$pkgdir"/usr/lib/udev/rules.d/92-lithium-sensors.rules
	install -Dm644 "$srcdir"/mpv.conf "$pkgdir"/etc/mpv/mpv.conf
	install -Dm644 "$srcdir"/libcamera-ov16880.yaml \
		"$pkgdir"/usr/share/libcamera/ipa/simple/ov16880.yaml
	install -Dm644 "$srcdir"/libcamera-ov5675.yaml \
		"$pkgdir"/usr/share/libcamera/ipa/simple/ov5675.yaml

	# Modem: file-backed rmtfs, then SIM provisioning and IPA (mobile data)
	install -Dm644 "$srcdir"/rmtfs-lithium.conf \
		"$pkgdir"/usr/lib/systemd/system/rmtfs.service.d/lithium.conf
	install -Dm644 "$srcdir"/lithium-rmtfs-setup.service \
		"$pkgdir"/usr/lib/systemd/system/lithium-rmtfs-setup.service
	install -Dm755 "$srcdir"/lithium-rmtfs-setup \
		"$pkgdir"/usr/libexec/lithium-rmtfs-setup
	install -Dm755 "$srcdir"/lithium-modem "$pkgdir"/usr/libexec/lithium-modem
	install -Dm644 "$srcdir"/lithium-modem.service \
		"$pkgdir"/usr/lib/systemd/system/lithium-modem.service
	install -Dm644 "$srcdir"/modprobe-lithium-ipa.conf \
		"$pkgdir"/usr/lib/modprobe.d/lithium-ipa.conf
	install -Dm644 "$srcdir"/90-lithium.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-lithium.preset
}

