#!/bin/sh
# Xiaomi Mi MIX (lithium): use a self-powered USB-C dock as a host port.
#
# The TUSB320L Type-C controller has no USB Power Delivery, so a dock that
# powers the phone attaches as a source and the phone becomes a USB device,
# just as with a computer. Tell them apart: a computer configures the USB
# gadget within a few seconds, a dock never does. A wall charger (DCP) is
# left alone. Run on every charger extcon change (udev); the TUSB320L resets
# the role on unplug. The OTG boost refuses to run while the port is powered
# (kernel guard), so host mode here never drives VBUS against the dock.
set -u

ROLE=/sys/class/usb_role/6a00000.usb-role-switch/role
UDC=/sys/class/udc/6a00000.usb/state
CHG=$(grep -l "charger@1000" /sys/class/extcon/extcon*/name 2>/dev/null | head -1)
CHG=${CHG%/name}/state

log() { logger -t lithium-usb-dock "$*"; }

[ -w "$ROLE" ] && [ -r "$CHG" ] || exit 0
grep -qx "SDP=1" "$CHG" || exit 0           # only a data-capable source
[ "$(cat "$ROLE")" = device ] || exit 0

i=0
while [ $i -lt 6 ]; do                      # up to 3 s for a computer to talk
	case "$(cat "$UDC" 2>/dev/null)" in
	configured|addressed) exit 0 ;;
	esac
	grep -qx "USB=1" "$CHG" || exit 0         # unplugged meanwhile
	sleep 0.5
	i=$((i + 1))
done

log "powered source without a USB host: treating it as a dock, switching to host"
echo host > "$ROLE"
