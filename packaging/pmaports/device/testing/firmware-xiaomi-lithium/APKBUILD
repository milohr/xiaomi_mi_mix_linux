# Firmware extracted locally from the user's own Xiaomi Mi MIX stock image.
# The source tarball is built by scripts/make-firmware-tarball.sh and never committed.
maintainer="Camilo Higuita <milo.h@aol.com>"
pkgname=firmware-xiaomi-lithium
pkgver=20261018
pkgrel=3
pkgdesc="Device-specific firmware for Xiaomi Mi MIX"
url="https://github.com/milohr/xiaomi_mi_mix_linux"
arch="aarch64"
license="proprietary"
options="!strip !check !archcheck !tracedeps pmb:cross-native"
depends="
	linux-firmware-ath10k
	linux-firmware-qca
	linux-firmware-qcom
	"

_archive="firmware-lithium-$pkgver"
source="$_archive.tar.gz"

package() {
	cd "$srcdir/$_archive"
	mkdir -p "$pkgdir/lib/firmware"
	cp -a firmware/. "$pkgdir/lib/firmware/"
}

sha512sums="
3cf1c29448fba78e930e00e2904d59e3b104015453374c1a91c7b1f2253cc3f29cfe54fda5d7224ac4db4409da509b31f70e858f33dab5fc5c451522fc407f09  firmware-lithium-20261018.tar.gz
"
