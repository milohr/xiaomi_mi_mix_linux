# Touch fragment for patch 0002 (docs/TOUCH.md). Not in kernel/lithium.config:
# the pinned pmaports linux-postmarketos-qcom-msm8996 config does not enable
# the driver ("# CONFIG_TOUCHSCREEN_EDT_FT5X06 is not set"), so adding touch
# means changing that package's config too. A module is enough.
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_I2C_QUP=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
