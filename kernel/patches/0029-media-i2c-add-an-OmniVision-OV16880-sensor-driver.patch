+static inline struct ov16880 *to_ov16880(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ov16880, sd);
+}
+
+static int ov16880_read_reg(struct ov16880 *ov16880, u16 reg, u16 len, u32 *val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&ov16880->sd);
+	struct i2c_msg msgs[2];
+	u8 addr_buf[2];
+	u8 data_buf[4] = { 0 };
+	int ret;
+
+	if (len > 4)
+		return -EINVAL;
+
+	put_unaligned_be16(reg, addr_buf);
+	msgs[0].addr = client->addr;
+	msgs[0].flags = 0;
+	msgs[0].len = sizeof(addr_buf);
+	msgs[0].buf = addr_buf;
+	msgs[1].addr = client->addr;
+	msgs[1].flags = I2C_M_RD;
+	msgs[1].len = len;
+	msgs[1].buf = &data_buf[4 - len];
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret != ARRAY_SIZE(msgs))
+		return -EIO;
+
+	*val = get_unaligned_be32(data_buf);
+
+	return 0;
+}
+
+static int ov16880_write_reg(struct ov16880 *ov16880, u16 reg, u16 len, u32 val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&ov16880->sd);
+	u8 buf[6];
+
+	if (len > 4)
+		return -EINVAL;
+
+	put_unaligned_be16(reg, buf);
+	put_unaligned_be32(val << 8 * (4 - len), buf + 2);
+	if (i2c_master_send(client, buf, len + 2) != len + 2)
+		return -EIO;
+
+	return 0;
+}
+
+static int ov16880_write_reg_list(struct ov16880 *ov16880,
+				  const struct ov16880_reg *regs, u32 num)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < num; i++) {
+		ret = ov16880_write_reg(ov16880, regs[i].address, 1, regs[i].val);
+		if (ret) {
+			dev_err_ratelimited(ov16880->dev,
+					    "failed to write reg 0x%4.4x: %d\n",
+					    regs[i].address, ret);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static int ov16880_update_bits(struct ov16880 *ov16880, u16 reg, u8 mask, u8 val)
+{
+	u32 cur;
+	int ret;
+
+	ret = ov16880_read_reg(ov16880, reg, OV16880_REG_VALUE_08BIT, &cur);
+	if (ret)
+		return ret;
+
+	return ov16880_write_reg(ov16880, reg, OV16880_REG_VALUE_08BIT,
+				 (cur & ~mask) | (val & mask));
+}
+
+static int ov16880_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov16880 *ov16880 = container_of(ctrl->handler, struct ov16880,
+					       ctrl_handler);
+	s64 exposure_max;
+	int ret = 0;
+
+	/* Propagate change of current control to all related controls */
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		exposure_max = ov16880->cur_mode->height + ctrl->val -
+			       OV16880_EXPOSURE_MAX_MARGIN;
+		__v4l2_ctrl_modify_range(ov16880->exposure,
+					 ov16880->exposure->minimum,
+					 exposure_max, ov16880->exposure->step,
+					 min(ov16880->exposure->default_value,
+					     exposure_max));
+	}
+
+	/* V4L2 controls values will be applied only when power is already up */
+	if (!pm_runtime_get_if_in_use(ov16880->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = ov16880_write_reg(ov16880, OV16880_REG_ANALOG_GAIN,
+					OV16880_REG_VALUE_16BIT, ctrl->val & 0x7ff);
+		break;
+
+	case V4L2_CID_EXPOSURE:
+		ret = ov16880_write_reg(ov16880, OV16880_REG_EXPOSURE,
+					OV16880_REG_VALUE_24BIT,
+					(ctrl->val << 4) & 0xfffff);
+		break;
+
+	case V4L2_CID_VBLANK:
+		ret = ov16880_write_reg(ov16880, OV16880_REG_VTS,
+					OV16880_REG_VALUE_16BIT,
+					ov16880->cur_mode->height + ctrl->val);
+		break;
+
+	case V4L2_CID_TEST_PATTERN:
+		ret = ov16880_write_reg(ov16880, OV16880_REG_TEST_PATTERN,
+					OV16880_REG_VALUE_08BIT,
+					ctrl->val ? 0x01 : 0x00);
+		break;
+
+	case V4L2_CID_HFLIP:
+		ret = ov16880_update_bits(ov16880, OV16880_REG_FORMAT2, BIT(2),
+					  ctrl->val ? BIT(2) : 0);
+		break;
+
+	case V4L2_CID_VFLIP:
+		/* Flipping also moves the black level lines (Rockchip driver) */
+		ret = ov16880_update_bits(ov16880, OV16880_REG_FORMAT1,
+					  BIT(2) | BIT(6),
+					  ctrl->val ? BIT(2) | BIT(6) : 0);
+		if (!ret)
+			ret = ov16880_update_bits(ov16880, OV16880_REG_BLC_CTRL,
+						  BIT(6), ctrl->val ? BIT(6) : 0);
+		break;
+
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(ov16880->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov16880_ctrl_ops = {
+	.s_ctrl = ov16880_set_ctrl,
+};
+
+static int ov16880_init_controls(struct ov16880 *ov16880)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &ov16880->ctrl_handler;
+	const struct ov16880_mode *mode = ov16880->cur_mode;
+	struct v4l2_fwnode_device_properties props;
+	s64 vblank_def, h_blank, exposure_max;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 12);
+	if (ret)
+		return ret;
+
+	ctrl_hdlr->lock = &ov16880->mutex;
+
+	ov16880->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &ov16880_ctrl_ops,
+						    V4L2_CID_LINK_FREQ,
+						    ARRAY_SIZE(link_freq_menu_items) - 1,
+						    mode->link_freq_index,
+						    link_freq_menu_items);
+	if (ov16880->link_freq)
+		ov16880->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ov16880->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &ov16880_ctrl_ops,
+						V4L2_CID_PIXEL_RATE, 0,
+						OV16880_PIXEL_RATE_MAX, 1,
+						ov16880_pixel_rate(mode));
+
+	vblank_def = mode->vts_def - mode->height;
+	ov16880->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &ov16880_ctrl_ops,
+					    V4L2_CID_VBLANK, vblank_def,
+					    OV16880_VTS_MAX - mode->height, 1,
+					    vblank_def);
+
+	h_blank = mode->hts - mode->width;
+	ov16880->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &ov16880_ctrl_ops,
+					    V4L2_CID_HBLANK, h_blank, h_blank,
+					    1, h_blank);
+	if (ov16880->hblank)
+		ov16880->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &ov16880_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  OV16880_ANAL_GAIN_MIN, OV16880_ANAL_GAIN_MAX, 1,
+			  OV16880_ANAL_GAIN_DEFAULT);
+
+	exposure_max = mode->vts_def - OV16880_EXPOSURE_MAX_MARGIN;
+	ov16880->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &ov16880_ctrl_ops,
+					      V4L2_CID_EXPOSURE,
+					      OV16880_EXPOSURE_MIN, exposure_max,
+					      1, mode->exp_def);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &ov16880_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(ov16880_test_pattern_menu) - 1,
+				     0, 0, ov16880_test_pattern_menu);
+
+	ov16880->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &ov16880_ctrl_ops,
+					   V4L2_CID_HFLIP, 0, 1, 1, 0);
+	ov16880->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &ov16880_ctrl_ops,
+					   V4L2_CID_VFLIP, 0, 1, 1, 0);
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		goto err;
+	}
+
+	ret = v4l2_fwnode_device_parse(ov16880->dev, &props);
+	if (ret)
+		goto err;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &ov16880_ctrl_ops,
+					      &props);
+	if (ret)
+		goto err;
+
+	ov16880->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+err:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static void ov16880_update_pad_format(const struct ov16880_mode *mode,
+				      struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int ov16880_identify_module(struct ov16880 *ov16880)
+{
+	u32 val;
+	int ret;
+
+	if (ov16880->identified)
+		return 0;
+
+	ret = ov16880_read_reg(ov16880, OV16880_REG_CHIP_ID,
+			       OV16880_REG_VALUE_24BIT, &val);
+	if (ret)
+		return ret;
+
+	if (val != OV16880_CHIP_ID) {
+		dev_err(ov16880->dev, "chip id mismatch: %x != %x\n",
+			OV16880_CHIP_ID, val);
+		return -ENXIO;
+	}
+
+	ov16880->identified = true;
+
+	return 0;
+}
+
+static int ov16880_start_streaming(struct ov16880 *ov16880)
+{
+	const struct ov16880_mode *mode = ov16880->cur_mode;
+	int ret;
+
+	ret = ov16880_identify_module(ov16880);
+	if (ret)
+		return ret;
+
+	ret = ov16880_write_reg(ov16880, OV16880_REG_SOFTWARE_RESET,
+				OV16880_REG_VALUE_08BIT, 0x01);
+	if (ret)
+		return ret;
+	usleep_range(5000, 6000);
+
+	ret = ov16880_write_reg_list(ov16880, mode->init_regs,
+				     mode->num_init_regs);
+	if (ret) {
+		dev_err(ov16880->dev, "failed to set global registers\n");
+		return ret;
+	}
+
+	ret = ov16880_write_reg_list(ov16880, mode->regs, mode->num_regs);
+	if (ret) {
+		dev_err(ov16880->dev, "failed to set mode\n");
+		return ret;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(ov16880->sd.ctrl_handler);
+	if (ret)
+		return ret;
+
+	ret = ov16880_write_reg(ov16880, OV16880_REG_MODE_SELECT,
+				OV16880_REG_VALUE_08BIT, OV16880_MODE_STREAMING);
+	if (ret) {
+		dev_err(ov16880->dev, "failed to start streaming\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+static void ov16880_stop_streaming(struct ov16880 *ov16880)
+{
+	if (ov16880_write_reg(ov16880, OV16880_REG_MODE_SELECT,
+			      OV16880_REG_VALUE_08BIT, OV16880_MODE_STANDBY))
+		dev_err(ov16880->dev, "failed to stop streaming\n");
+}
+
+static int ov16880_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct ov16880 *ov16880 = to_ov16880(sd);
+	int ret = 0;
+
+	mutex_lock(&ov16880->mutex);
+	if (enable) {
+		ret = pm_runtime_resume_and_get(ov16880->dev);
+		if (ret < 0) {
+			mutex_unlock(&ov16880->mutex);
+			return ret;
+		}
+
+		ret = ov16880_start_streaming(ov16880);
+		if (ret) {
+			ov16880_stop_streaming(ov16880);
+			pm_runtime_put(ov16880->dev);
+		}
+	} else {
+		ov16880_stop_streaming(ov16880);
+		pm_runtime_put(ov16880->dev);
+	}
+
+	/* vflip and hflip cannot change while streaming */
+	__v4l2_ctrl_grab(ov16880->vflip, enable && !ret);
+	__v4l2_ctrl_grab(ov16880->hflip, enable && !ret);
+
+	mutex_unlock(&ov16880->mutex);
+
+	return ret;
+}
+
+/*
+ * The focus motor powers down once nobody holds it open, and its lens then
+ * falls back to the far end: keep it powered while the sensor is, so that a
+ * focus position set by any application holds while streaming.
+ */
+static void ov16880_lens_get(struct ov16880 *ov16880)
+{
+	struct fwnode_handle *fwnode;
+
+	if (!ov16880->lens) {
+		fwnode = fwnode_find_reference(dev_fwnode(ov16880->dev),
+					       "lens-focus", 0);
+		if (IS_ERR(fwnode))
+			return;
+		ov16880->lens = bus_find_device_by_fwnode(&i2c_bus_type, fwnode);
+		fwnode_handle_put(fwnode);
+		if (!ov16880->lens)
+			return;
+	}
+
+	if (device_is_bound(ov16880->lens))
+		ov16880->lens_on = pm_runtime_resume_and_get(ov16880->lens) >= 0;
+}
+
+static void ov16880_lens_put(struct ov16880 *ov16880)
+{
+	if (ov16880->lens_on) {
+		pm_runtime_put(ov16880->lens);
+		ov16880->lens_on = false;
+	}
+}
+
+static int ov16880_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov16880 *ov16880 = to_ov16880(sd);
+
+	ov16880_lens_put(ov16880);
+
+	gpiod_set_value_cansleep(ov16880->powerdown_gpio, 1);
+	gpiod_set_value_cansleep(ov16880->reset_gpio, 1);
+	regulator_bulk_disable(OV16880_NUM_SUPPLIES, ov16880->supplies);
+	clk_disable_unprepare(ov16880->xvclk);
+
+	return 0;
+}
+
+static int ov16880_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov16880 *ov16880 = to_ov16880(sd);
+	int ret;
+
+	ret = clk_prepare_enable(ov16880->xvclk);
+	if (ret < 0) {
+		dev_err(dev, "failed to enable xvclk: %d\n", ret);
+		return ret;
+	}
+
+	gpiod_set_value_cansleep(ov16880->reset_gpio, 1);
+
+	ret = regulator_bulk_enable(OV16880_NUM_SUPPLIES, ov16880->supplies);
+	if (ret) {
+		clk_disable_unprepare(ov16880->xvclk);
+		return ret;
+	}
+
+	gpiod_set_value_cansleep(ov16880->reset_gpio, 0);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ov16880->powerdown_gpio, 0);
+
+	/* 8192 XVCLK cycles prior to the first SCCB transaction */
+	usleep_range(1000, 1500);
+
+	ov16880_lens_get(ov16880);
+
+	return 0;
+}
+
+static int ov16880_set_format(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *sd_state,
+			      struct v4l2_subdev_format *fmt)
+{
+	struct ov16880 *ov16880 = to_ov16880(sd);
+	const struct ov16880_mode *mode;
+	s32 vblank_def, h_blank;
+
+	mode = v4l2_find_nearest_size(supported_modes,
+				      ARRAY_SIZE(supported_modes), width,
+				      height, fmt->format.width,
+				      fmt->format.height);
+
+	mutex_lock(&ov16880->mutex);
+	ov16880_update_pad_format(mode, &fmt->format);
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		*v4l2_subdev_state_get_format(sd_state, fmt->pad) = fmt->format;
+	} else {
+		ov16880->cur_mode = mode;
+		__v4l2_ctrl_s_ctrl(ov16880->link_freq, mode->link_freq_index);
+		__v4l2_ctrl_s_ctrl_int64(ov16880->pixel_rate,
+					 ov16880_pixel_rate(mode));
+
+		/* Update limits and set FPS to default */
+		vblank_def = mode->vts_def - mode->height;
+		__v4l2_ctrl_modify_range(ov16880->vblank, vblank_def,
+					 OV16880_VTS_MAX - mode->height, 1,
+					 vblank_def);
+		__v4l2_ctrl_s_ctrl(ov16880->vblank, vblank_def);
+		h_blank = mode->hts - mode->width;
+		__v4l2_ctrl_modify_range(ov16880->hblank, h_blank, h_blank, 1,
+					 h_blank);
+	}
+	mutex_unlock(&ov16880->mutex);
+
+	return 0;
+}
+
+static int ov16880_get_format(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *sd_state,
+			      struct v4l2_subdev_format *fmt)
+{
+	struct ov16880 *ov16880 = to_ov16880(sd);
+
+	mutex_lock(&ov16880->mutex);
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		fmt->format = *v4l2_subdev_state_get_format(sd_state, fmt->pad);
+	else
+		ov16880_update_pad_format(ov16880->cur_mode, &fmt->format);
+	mutex_unlock(&ov16880->mutex);
+
+	return 0;
+}
+
+static int ov16880_get_selection(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		sel->r.width = OV16880_NATIVE_WIDTH;
+		sel->r.height = OV16880_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int ov16880_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int ov16880_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *sd_state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(supported_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int ov16880_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	struct ov16880 *ov16880 = to_ov16880(sd);
+
+	mutex_lock(&ov16880->mutex);
+	ov16880_update_pad_format(&supported_modes[0],
+				  v4l2_subdev_state_get_format(fh->state, 0));
+	mutex_unlock(&ov16880->mutex);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops ov16880_video_ops = {
+	.s_stream = ov16880_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops ov16880_pad_ops = {
+	.set_fmt = ov16880_set_format,
+	.get_fmt = ov16880_get_format,
+	.get_selection = ov16880_get_selection,
+	.enum_mbus_code = ov16880_enum_mbus_code,
+	.enum_frame_size = ov16880_enum_frame_size,
+};
+
+static const struct v4l2_subdev_ops ov16880_subdev_ops = {
+	.video = &ov16880_video_ops,
+	.pad = &ov16880_pad_ops,
+};
+
+static const struct media_entity_operations ov16880_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static const struct v4l2_subdev_internal_ops ov16880_internal_ops = {
+	.open = ov16880_open,
+};
+
+static int ov16880_get_hwcfg(struct ov16880 *ov16880)
+{
+	struct device *dev = ov16880->dev;
+	struct fwnode_handle *ep;
+	struct fwnode_handle *fwnode = dev_fwnode(dev);
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+	unsigned int i, j;
+	u32 xvclk_rate;
+	int ret;
+
+	if (!fwnode)
+		return -ENXIO;
+
+	ov16880->xvclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(ov16880->xvclk))
+		return dev_err_probe(dev, PTR_ERR(ov16880->xvclk),
+				     "failed to get xvclk\n");
+
+	xvclk_rate = clk_get_rate(ov16880->xvclk);
+	if (xvclk_rate != OV16880_XVCLK) {
+		dev_err(dev, "xvclk is %u Hz, the register tables need %u\n",
+			xvclk_rate, OV16880_XVCLK);
+		return -EINVAL;
+	}
+
+	ov16880->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						      GPIOD_OUT_HIGH);
+	if (IS_ERR(ov16880->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov16880->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	ov16880->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							  GPIOD_OUT_HIGH);
+	if (IS_ERR(ov16880->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov16880->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	for (i = 0; i < OV16880_NUM_SUPPLIES; i++)
+		ov16880->supplies[i].supply = ov16880_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, OV16880_NUM_SUPPLIES,
+				      ov16880->supplies);
+	if (ret)
+		return ret;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != OV16880_DATA_LANES) {
+		dev_err(dev, "number of CSI2 data lanes %d is not supported\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto check_hwcfg_error;
+	}
+
+	if (!bus_cfg.nr_of_link_frequencies) {
+		dev_err(dev, "no link frequencies defined\n");
+		ret = -EINVAL;
+		goto check_hwcfg_error;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(link_freq_menu_items); i++) {
+		for (j = 0; j < bus_cfg.nr_of_link_frequencies; j++) {
+			if (link_freq_menu_items[i] == bus_cfg.link_frequencies[j])
+				break;
+		}
+
+		if (j == bus_cfg.nr_of_link_frequencies) {
+			dev_err(dev, "link frequency %lld not in the device tree\n",
+				link_freq_menu_items[i]);
+			ret = -EINVAL;
+			goto check_hwcfg_error;
+		}
+	}
+
+check_hwcfg_error:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static void ov16880_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov16880 *ov16880 = to_ov16880(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(ov16880->dev);
+	mutex_destroy(&ov16880->mutex);
+
+	if (!pm_runtime_status_suspended(ov16880->dev))
+		ov16880_power_off(ov16880->dev);
+	pm_runtime_set_suspended(ov16880->dev);
+	put_device(ov16880->lens);
+}
+
+static int ov16880_probe(struct i2c_client *client)
+{
+	struct ov16880 *ov16880;
+	int ret;
+
+	ov16880 = devm_kzalloc(&client->dev, sizeof(*ov16880), GFP_KERNEL);
+	if (!ov16880)
+		return -ENOMEM;
+
+	ov16880->dev = &client->dev;
+
+	ret = ov16880_get_hwcfg(ov16880);
+	if (ret)
+		return ret;
+
+	v4l2_i2c_subdev_init(&ov16880->sd, client, &ov16880_subdev_ops);
+
+	ret = ov16880_power_on(&client->dev);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "failed to power on\n");
+
+	ret = ov16880_identify_module(ov16880);
+	if (ret) {
+		dev_err(&client->dev, "failed to find sensor: %d\n", ret);
+		goto probe_power_off;
+	}
+
+	mutex_init(&ov16880->mutex);
+	ov16880->cur_mode = &supported_modes[0];
+	ret = ov16880_init_controls(ov16880);
+	if (ret) {
+		dev_err(&client->dev, "failed to init controls: %d\n", ret);
+		goto probe_error_v4l2_ctrl_handler_free;
+	}
+
+	ov16880->sd.internal_ops = &ov16880_internal_ops;
+	ov16880->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	ov16880->sd.entity.ops = &ov16880_subdev_entity_ops;
+	ov16880->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	ov16880->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&ov16880->sd.entity, 1, &ov16880->pad);
+	if (ret) {
+		dev_err(&client->dev, "failed to init entity pads: %d\n", ret);
+		goto probe_error_v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_async_register_subdev_sensor(&ov16880->sd);
+	if (ret < 0) {
+		dev_err(&client->dev, "failed to register V4L2 subdev: %d\n",
+			ret);
+		goto probe_error_media_entity_cleanup;
+	}
+
+	/* Set the device's state to active if it's in D0 state. */
+	pm_runtime_set_active(&client->dev);
+	pm_runtime_enable(&client->dev);
+	pm_runtime_idle(&client->dev);
+
+	return 0;
+
+probe_error_media_entity_cleanup:
+	media_entity_cleanup(&ov16880->sd.entity);
+
+probe_error_v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(ov16880->sd.ctrl_handler);
+	mutex_destroy(&ov16880->mutex);
+probe_power_off:
+	ov16880_power_off(&client->dev);
+
+	return ret;
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(ov16880_pm_ops, ov16880_power_off,
+				 ov16880_power_on, NULL);
+
+static const struct of_device_id ov16880_of_match[] = {
+	{ .compatible = "ovti,ov16880" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ov16880_of_match);
+
+static struct i2c_driver ov16880_i2c_driver = {
+	.driver = {
+		.name = "ov16880",
+		.pm = pm_ptr(&ov16880_pm_ops),
+		.of_match_table = ov16880_of_match,
+	},
+	.probe = ov16880_probe,
+	.remove = ov16880_remove,
+};
+
+module_i2c_driver(ov16880_i2c_driver);
+
+MODULE_DESCRIPTION("OmniVision OV16880 sensor driver");
+MODULE_LICENSE("GPL");
