+ * OmniVision OV16880 16 MP image sensor driver.
+ *
+ * Register tables from the Xiaomi Mi MIX (lithium) stock camera library
+ * (libmmcamera_ov16880.so); power sequence after the Rockchip ov16880 driver;
+ * driver structure after the mainline ov5675 driver.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
