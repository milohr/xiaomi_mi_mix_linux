+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define OV16880_XVCLK			24000000
+#define OV16880_DATA_LANES		4
+#define OV16880_BITS_PER_SAMPLE		10
+/* Highest link frequency of the modes (636 MHz) */
+#define OV16880_PIXEL_RATE_MAX		(636000000ULL * 2 * OV16880_DATA_LANES / \
+					 OV16880_BITS_PER_SAMPLE)
+
+#define OV16880_REG_CHIP_ID		0x300a
+#define OV16880_CHIP_ID			0x016880
+
+#define OV16880_REG_MODE_SELECT		0x0100
+#define OV16880_MODE_STANDBY		0x00
+#define OV16880_MODE_STREAMING		0x01
+#define OV16880_REG_SOFTWARE_RESET	0x0103
+
+/* Exposure in lines; the low 4 bits of 0x3500-0x3502 are a fraction */
+#define OV16880_REG_EXPOSURE		0x3500
+#define OV16880_EXPOSURE_MIN		8
+#define OV16880_EXPOSURE_MAX_MARGIN	8
+
+#define OV16880_REG_ANALOG_GAIN		0x350a
+#define OV16880_ANAL_GAIN_MIN		0x10
+#define OV16880_ANAL_GAIN_MAX		0xf8
+#define OV16880_ANAL_GAIN_DEFAULT	0x20
+
+#define OV16880_REG_VTS			0x380e
+#define OV16880_VTS_MAX			0x7fff
+
+#define OV16880_REG_TEST_PATTERN	0x5081
+#define OV16880_REG_FORMAT1		0x3820	/* vertical flip */
+#define OV16880_REG_FORMAT2		0x3821	/* horizontal mirror */
+#define OV16880_REG_BLC_CTRL		0x4000
+
+#define OV16880_REG_VALUE_08BIT		1
+#define OV16880_REG_VALUE_16BIT		2
+#define OV16880_REG_VALUE_24BIT		3
+
+#define OV16880_NATIVE_WIDTH		4672
+#define OV16880_NATIVE_HEIGHT		3504
+
+struct ov16880_reg {
+	u16 address;
+	u8 val;
+};
