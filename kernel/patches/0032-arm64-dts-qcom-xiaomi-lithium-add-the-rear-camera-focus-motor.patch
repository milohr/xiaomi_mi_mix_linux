From: Xiaomi Mi MIX Linux port contributors
Subject: [PATCH] arm64: dts: qcom: xiaomi-lithium: add the rear camera focus motor

DW9763 at 0x0c on CCI0 (stock libactuator_dw9763_a8_o-film), driven by
dw9719 as a DW9761 with stock's SAC mode 4 and prescale 0x3c, vdd L23
2.8 V, linked to the OV16880 as its lens. LVS1 (camera I/O, a switch on
the always-on S4 1.8 V rail) stays on, since the motor driver only
manages vdd and must reach the chip at probe.

---
diff --git a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
--- a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
@@ -696,6 +696,8 @@
 			regulator-name = "vreg_lvs1a_1p8";
 			regulator-min-microvolt = <1800000>;
 			regulator-max-microvolt = <1800000>;
+			/* Camera I/O; the focus motor driver only manages its vdd */
+			regulator-always-on;
 		};
 
 		vreg_lvs2a_1p8: lvs2 {
@@ -1067,6 +1069,18 @@
 &cci_i2c0 {
 	clock-frequency = <400000>;
 
+	/*
+	 * Rear camera focus motor: DW9763 (stock libactuator_dw9763_a8_o-film), the
+	 * DW9761 register map. Stock init: mode 0x41 (SAC 4), prescale 0x3c.
+	 */
+	rear_vcm: camera-lens@c {
+		compatible = "dongwoon,dw9761";
+		reg = <0x0c>;
+		vdd-supply = <&vreg_l23a_2p8>;
+		dongwoon,sac-mode = <4>;
+		dongwoon,vcm-prescale = <0x3c>;
+	};
+
 	/* Rear camera, identified on hardware (chip ID 0x016880 at 0x36, OFilm module) */
 	camera-sensor@36 {
 		compatible = "ovti,ov16880";
@@ -1090,6 +1104,8 @@
 		orientation = <1>;
 		rotation = <90>;
 
+		lens-focus = <&rear_vcm>;
+
 		port {
 			ov16880_ep: endpoint {
 				data-lanes = <1 2 3 4>;
