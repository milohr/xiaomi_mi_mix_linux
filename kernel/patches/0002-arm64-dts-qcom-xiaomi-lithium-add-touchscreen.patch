From: Xiaomi Mi MIX Linux port contributors
Subject: [PATCH] arm64: dts: qcom: xiaomi-lithium: add touchscreen

Enable the FocalTech FTE8716 in-cell touchscreen on BLSP2 QUP6 at 400 kHz,
with the interrupt (GPIO 125, falling edge), reset (GPIO 89, active low),
pin states and 1080x2040 size the stock device tree and driver use. Describe
its PM8994 L14 1.8 V supply and keep it on, since the bootloader splash also
depends on that rail.

---
 .../boot/dts/qcom/msm8996pro-xiaomi-lithium.dts    | 59 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 59 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
index d1095ae..0a8b415 100644
--- a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-lithium.dts
@@ -10,6 +10,7 @@
 #include <dt-bindings/clock/qcom,rpmcc.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 #include "msm8996pro.dtsi"
 #include "pm8994.dtsi"
@@ -103,6 +104,37 @@
 	};
 };
 
+/* Stock i2c@75ba000 (BLSP2 QUP6) at 400 kHz. */
+&blsp2_i2c6 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	/*
+	 * FocalTech FTE8716 in-cell touch. The stock driver (ft5x46) takes its
+	 * interrupt from irq-gpio 125 with a hard-coded falling edge; the stale
+	 * "interrupts" value of the stock node is unused. Firmware lives in the
+	 * controller's flash; Android only reflashes on a version change.
+	 */
+	touchscreen@38 {
+		compatible = "focaltech,ft8716";
+		reg = <0x38>;
+
+		interrupts-extended = <&tlmm 125 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 89 GPIO_ACTIVE_LOW>;
+
+		vcc-supply = <&vreg_l14a_1p8>;
+		iovcc-supply = <&vreg_l14a_1p8>;
+
+		pinctrl-0 = <&ts_int_default>;
+		pinctrl-1 = <&ts_int_sleep>;
+		pinctrl-names = "default", "sleep";
+
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <2040>;
+	};
+};
+
 /* Stock console UART: serial@75b0000 on gpio4/gpio5, ttyHSL0. */
 &blsp2_uart2 {
 	pinctrl-0 = <&blsp2_uart2_2pins_default>;
@@ -175,6 +207,17 @@
 			regulator-max-microvolt = <1800000>;
 		};
 
+		/*
+		 * Display and touch 1.8 V rail. Kept on: the bootloader splash
+		 * scans out through it until a panel driver owns it.
+		 */
+		vreg_l14a_1p8: l14 {
+			regulator-name = "vreg_l14a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
+		};
+
 		vreg_l20a_2p95: l20 {
 			regulator-name = "vreg_l20a_2p95";
 			regulator-min-microvolt = <2950000>;
@@ -203,6 +246,22 @@
 	};
 };
 
+&tlmm {
+	ts_int_default: ts-int-default-state {
+		pins = "gpio125";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-pull-up;
+	};
+
+	ts_int_sleep: ts-int-sleep-state {
+		pins = "gpio125";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
+
 &ufshc {
 	vcc-supply = <&vreg_l20a_2p95>;
 	vccq-supply = <&vreg_l25a_1p2>;
