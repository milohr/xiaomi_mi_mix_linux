From: Xiaomi Mi MIX Linux port contributors
Subject: [PATCH] ASoC: qcom: apq8096: clock quaternary MI2S for external amplifiers

The apq8096 machine driver only configures SLIMbus links. Boards with an
amplifier on quaternary MI2S (Xiaomi Mi MIX: TFA9890) need the DSP to
drive the bit clock and the I2S format set as on sdm845. MSM8996 sits
between the AFE clock APIs: try the clock-set API and fall back to the
LPAIF bit clock config, logging which one the DSP accepted.


---
diff --git a/sound/soc/qcom/apq8096.c b/sound/soc/qcom/apq8096.c
--- a/sound/soc/qcom/apq8096.c
+++ b/sound/soc/qcom/apq8096.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 // Copyright (c) 2018, Linaro Limited
 
+#include <dt-bindings/sound/qcom,q6afe.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
@@ -8,10 +9,12 @@
 #include <sound/soc-dapm.h>
 #include <sound/pcm.h>
 #include "common.h"
+#include "qdsp6/q6afe.h"
 
 #define SLIM_MAX_TX_PORTS 16
 #define SLIM_MAX_RX_PORTS 16
 #define WCD9335_DEFAULT_MCLK_RATE	9600000
+#define MI2S_BCLK_RATE			1536000
 
 static int apq8096_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 				      struct snd_pcm_hw_params *params)
@@ -60,7 +63,61 @@
 	return ret;
 }
 
+/* External amplifiers on quaternary MI2S: the DSP is bit clock and frame master. */
+static int apq8096_snd_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+
+	int ret;
+
+	switch (cpu_dai->id) {
+	case QUATERNARY_MI2S_RX:
+		/*
+		 * Newer AFE firmware takes the clock-set API, older the LPAIF
+		 * bit clock config; try both, the DSP rejects what it lacks.
+		 */
+		ret = snd_soc_dai_set_sysclk(cpu_dai, Q6AFE_LPASS_CLK_ID_QUAD_MI2S_IBIT,
+					     MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+		if (ret) {
+			ret = snd_soc_dai_set_sysclk(cpu_dai, LPAIF_BIT_CLK,
+						     MI2S_BCLK_RATE, 0);
+			dev_info(rtd->dev, "quaternary MI2S bit clock (LPAIF): %d\n", ret);
+		} else {
+			dev_info(rtd->dev, "quaternary MI2S bit clock (clock set): 0\n");
+		}
+		snd_soc_dai_set_fmt(cpu_dai, SND_SOC_DAIFMT_BP_FP);
+		snd_soc_dai_set_fmt(codec_dai, SND_SOC_DAIFMT_BC_FC |
+				    SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S);
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
+
+static void apq8096_snd_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
+	switch (cpu_dai->id) {
+	case QUATERNARY_MI2S_RX:
+		/* Only the API that was accepted at startup does anything. */
+		snd_soc_dai_set_sysclk(cpu_dai, Q6AFE_LPASS_CLK_ID_QUAD_MI2S_IBIT,
+				       0, SNDRV_PCM_STREAM_PLAYBACK);
+		snd_soc_dai_set_sysclk(cpu_dai, LPAIF_BIT_CLK, 0, 0);
+		break;
+	default:
+		break;
+	}
+}
+
 static const struct snd_soc_ops apq8096_ops = {
+	.startup = apq8096_snd_startup,
+	.shutdown = apq8096_snd_shutdown,
 	.hw_params = msm_snd_hw_params,
 };
 
