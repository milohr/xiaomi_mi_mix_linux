+
+static void wcd9335_mbhc_clk_setup(struct snd_soc_component *component, bool enable)
+{
+	snd_soc_component_update_bits(component, WCD9335_MBHC_CTL_1,
+				      WCD9335_MBHC_CTL_RCO_EN_MASK,
+				      enable ? WCD9335_MBHC_CTL_RCO_EN : 0);
+}
+
+static void wcd9335_mbhc_bias(struct snd_soc_component *component, bool enable)
+{
+	snd_soc_component_update_bits(component, WCD9335_ANA_MBHC_ELECT,
+				      WCD9335_ANA_MBHC_BIAS_EN_MASK,
+				      enable ? WCD9335_ANA_MBHC_BIAS_EN : 0);
+}
+
+static void wcd9335_mbhc_set_btn_thr(struct snd_soc_component *component,
+				    int *btn_low, int *btn_high,
+				    int num_btn, bool is_micbias)
+{
+	int i;
+
+	for (i = 0; i < min(num_btn, WCD_MBHC_DEF_BUTTONS); i++)
+		snd_soc_component_update_bits(component, WCD9335_ANA_MBHC_BTN0 + i,
+					      0x3f, ((btn_high[i] * 2) / 25) & 0x3f);
+}
+
+static bool wcd9335_mbhc_micbias_enabled(struct snd_soc_component *component,
+					 int micb_num)
+{
+	return micb_num == MIC_BIAS_2 &&
+		(snd_soc_component_read(component, WCD9335_ANA_MICB2) & 0xc0) == 0x40;
+}
+
+static void wcd9335_mbhc_hph_pull_up(struct snd_soc_component *component,
+				    enum mbhc_hs_pullup_iref pull_up)
+{
+	if (pull_up < I_OFF || pull_up > I_3P0_UA || pull_up == I_DEFAULT)
+		pull_up = I_2P0_UA;
+	snd_soc_component_update_bits(component, WCD9335_MBHC_PLUG_DETECT_CTL,
+				      0xc0, pull_up << 6);
+}
+
+static int wcd9335_mbhc_micbias(struct snd_soc_component *component,
+				int micb_num, int req)
+{
+	return wcd9335_micbias_control(component, micb_num, req, false);
+}
+
+static void wcd9335_mbhc_micb_ramp(struct snd_soc_component *component, bool enable)
+{
+	snd_soc_component_update_bits(component, WCD9335_ANA_MICB2_RAMP,
+				      0x1c, enable ? 0x1c : 0);
+}
+
+static int wcd9335_mbhc_threshold_mic(struct snd_soc_component *component,
+				     int micb_num, bool enable)
+{
+	return micb_num == MIC_BIAS_2 ? 0 : -EINVAL;
+}
+
+static void wcd9335_mbhc_gnd_det(struct snd_soc_component *component, bool enable)
+{
+	snd_soc_component_update_bits(component, WCD9335_ANA_MBHC_MECH,
+				      0x42, enable ? 0x42 : 0);
+}
+
+static void wcd9335_mbhc_hph_pull_down(struct snd_soc_component *component,
+				      bool enable)
+{
+	snd_soc_component_update_bits(component, WCD9335_HPH_PA_CTL2,
+				      0x50, enable ? 0x50 : 0);
+}
+
+static const struct wcd_mbhc_cb wcd9335_mbhc_cb = {
+	.clk_setup = wcd9335_mbhc_clk_setup,
+	.mbhc_bias = wcd9335_mbhc_bias,
+	.set_btn_thr = wcd9335_mbhc_set_btn_thr,
+	.micbias_enable_status = wcd9335_mbhc_micbias_enabled,
+	.hph_pull_up_control = wcd9335_mbhc_hph_pull_up,
+	.mbhc_micbias_control = wcd9335_mbhc_micbias,
+	.mbhc_micb_ramp_control = wcd9335_mbhc_micb_ramp,
+	.mbhc_micb_ctrl_thr_mic = wcd9335_mbhc_threshold_mic,
+	.mbhc_gnd_det_ctrl = wcd9335_mbhc_gnd_det,
+	.hph_pull_down_ctrl = wcd9335_mbhc_hph_pull_down,
+};
+
+static void wcd9335_mbhc_init(struct snd_soc_component *component)
+{
+	struct wcd9335_codec *wcd = snd_soc_component_get_drvdata(component);
+	struct wcd_mbhc_intr *intr = &wcd->mbhc_intr;
+	struct wcd_mbhc_config *cfg = &wcd->mbhc_cfg;
+
+	intr->mbhc_sw_intr = regmap_irq_get_virq(wcd->irq_data, WCD9335_IRQ_MBHC_SW_DET);
+	intr->mbhc_btn_press_intr = regmap_irq_get_virq(wcd->irq_data, WCD9335_IRQ_MBHC_BUTTON_PRESS_DET);
+	intr->mbhc_btn_release_intr = regmap_irq_get_virq(wcd->irq_data, WCD9335_IRQ_MBHC_BUTTON_RELEASE_DET);
+	intr->mbhc_hs_ins_intr = regmap_irq_get_virq(wcd->irq_data, WCD9335_IRQ_MBHC_ELECT_INS_REM_LEG_DET);
+	intr->mbhc_hs_rem_intr = regmap_irq_get_virq(wcd->irq_data, WCD9335_IRQ_MBHC_ELECT_INS_REM_DET);
+	intr->hph_left_ocp = regmap_irq_get_virq(wcd->irq_data, WCD9335_IRQ_HPH_PA_OCPL_FAULT);
+	intr->hph_right_ocp = regmap_irq_get_virq(wcd->irq_data, WCD9335_IRQ_HPH_PA_OCPR_FAULT);
+
+	/* Defaults as for WCD934x; the board's switch types come from DT. */
+	cfg->mbhc_micbias = MIC_BIAS_2;
+	cfg->anc_micbias = MIC_BIAS_2;
+	cfg->v_hs_max = WCD_MBHC_HS_V_MAX;
+	/* No button thresholds are known for any WCD9335 board yet. */
+	cfg->num_btn = 0;
+	/* This driver leaves MICBIAS2 at its 1.8 V reset value. */
+	cfg->micb_mv = WCD9335_MICBIAS2_DEFAULT_MV;
+	cfg->linein_th = 5000;
+	cfg->hs_thr = 1700;
+	cfg->hph_thr = 50;
+	/*
+	 * WCD9335 has no MBHC ADC, which the generic plug-type detection
+	 * needs (downstream used a separate legacy method): detect
+	 * headphones by the jack switch only; no headset mic yet.
+	 */
+	cfg->mech_only = true;
+	wcd_dt_parse_mbhc_data(component->dev, cfg);
+
+	wcd->mbhc = wcd_mbhc_init(component, &wcd9335_mbhc_cb, intr,
+				  wcd9335_mbhc_fields, false);
+	if (IS_ERR(wcd->mbhc)) {
+		dev_warn(component->dev, "no headset detection: %pe\n",
+			 wcd->mbhc);
+		wcd->mbhc = NULL;
+	}
+}
+
+static int wcd9335_codec_set_jack(struct snd_soc_component *component,
+				  struct snd_soc_jack *jack, void *data)
+{
+	struct wcd9335_codec *wcd = snd_soc_component_get_drvdata(component);
+	int ret = 0;
+
+	if (!wcd->mbhc)
+		return -ENOTSUPP;
+	if (jack && !wcd->mbhc_started) {
+		ret = wcd_mbhc_start(wcd->mbhc, &wcd->mbhc_cfg, jack);
+		if (!ret)
+			wcd->mbhc_started = true;
+	} else if (!jack && wcd->mbhc_started) {
+		wcd_mbhc_stop(wcd->mbhc);
+		wcd->mbhc_started = false;
+	}
+	return ret;
+}
