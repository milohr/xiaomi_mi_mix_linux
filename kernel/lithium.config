# Minimal options for msm8996pro-xiaomi-lithium.dts first boot.
# Each line serves an enabled DTS node or the lk2nd boot path; see
# docs/PHASE3_FINDINGS.md. Checked against the pinned pmaports
# linux-postmarketos-qcom-msm8996 config by scripts/check_kernel_config.py.

# SoC, pinctrl, RPM and regulators
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_MSM8996=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMPD=y
CONFIG_MSM_GCC_8996=y

# Console UART (blsp2_uart2)
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y

# Keys: PON power/resin, PM8994 GPIO volume up
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y

# UFS storage
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y

# USB peripheral (diagnostic networking)
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y

# lk2nd hand-off: simple-framebuffer and ramoops nodes it inserts
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
